+
+			if (options.cwd.length > 0)
+				throw new Error.NOT_SUPPORTED ("The 'cwd' option is not supported when spawning Android apps");
+
+			if (options.stdio != INHERIT)
+				throw new Error.NOT_SUPPORTED ("Redirected stdio is not supported when spawning Android apps");
+
+			var entrypoint = PackageEntrypoint.parse (package, options);
+
+			string output;
+			string error_output;
+			int status;
+
+			GLib.Process.spawn_command_line_sync ("/system/bin/am force-stop " + package,
+				out output, out error_output, out status);
+
+			string start_cmd;
+			if (entrypoint is DefaultActivityEntrypoint) {
+				start_cmd = "/system/bin/monkey -p " + package + " -c android.intent.category.LAUNCHER 1";
+			} else if (entrypoint is ActivityEntrypoint) {
+				var e = entrypoint as ActivityEntrypoint;
+				start_cmd = "/system/bin/am start -n " + package + "/" + e.activity;
+			} else if (entrypoint is BroadcastReceiverEntrypoint) {
+				var e = entrypoint as BroadcastReceiverEntrypoint;
+				start_cmd = "/system/bin/am broadcast -a " + e.action + " -n " + package + "/" + e.receiver;
+			} else {
+				assert_not_reached ();
+			}
+
+			GLib.Process.spawn_command_line_sync (start_cmd, out output, out error_output, out status);
+
+			var request = new Promise<uint> ();
+
+			var timeout = new TimeoutSource.seconds (20);
+			timeout.set_callback (() => {
+				request.reject (new Error.TIMED_OUT ("Unexpectedly timed out while waiting for app to launch"));
+				return false;
+			});
+			timeout.attach (MainContext.get_thread_default ());
+
+			var poll = new TimeoutSource (200);
+			poll.set_callback (() => {
+				uint pid = LocalProcesses.find_pid (package);
+				if (pid != 0) {
+					request.resolve (pid);
+					return false;
+				}
+				return true;
+			});
+			poll.attach (MainContext.get_thread_default ());
+
+			uint pid = 0;
+			try {
+				pid = yield request.future.wait_async (cancellable);
+			} finally {
+				timeout.destroy ();
+				poll.destroy ();
+			}
+
+			compat_spawn_pids.add (pid);
+
+			return pid;
+		}
+#endif
